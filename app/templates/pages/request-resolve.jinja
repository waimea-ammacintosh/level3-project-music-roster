{#=====================================================
  Resolve request page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Resolve Request</h2>

    <section>

        <h5>Name: {{ request.f_name }} {{ request.l_name}}</h5>
        <h5>Date: {{ request.date}}</h5>
        <h5>Instrument: {% for instrument in instruments %}{{ instrument.name }}<br>{% endfor %}</h5>
        

        <h3>Message</h3>
        <h5>{{ request.message }}</h5>

        <h3>Replacement</h3>
        <form method="post" action="/request/resolve/{{ u_id }}/{{ w_id }}">
            {% for instrument in instruments %}
                <label>
                    {{ instrument.name }}
                    <select name="replacement-{{ instrument.name }}">
                        {% for user in available_users %}
                            {% if instrument.name == user.instrument %}
                                <option value="{{ user.u_id }}">{{ user.f_name }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </label>
            {% endfor %}
            <button>Submit Change</button>
        </form>
           

    </section>
    <button onclick="window.location.href='/';">Back</button>

{% endblock %}


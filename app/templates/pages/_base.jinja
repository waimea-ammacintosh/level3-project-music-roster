{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Notes Demo {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/logo.png">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    {% if session["logged_in"] %}
        <header>
            <a href="/">
                <img class="nav_img" src="/static/images/logo.png" alt="Logo of Rosterer">
            </a>

            <h4>Welcome {{session["user"]["first_name"]}}</h4>

            <a href="/logout">
                <img class="nav_img" src="/static/images/log-out.svg" alt="Logout">
            </a>


        </header>
    {% endif %}

    {# Show flash messages from any previous events #}
    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>


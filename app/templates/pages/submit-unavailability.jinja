{#=====================================================
  Submit Unavailability page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Select Unavailability</h2>
    <section>
      {% if weeks %}
        <form method="post" action="/unavailability">
          <h4>Select the dates you are <strong>Unavailable</strong> for:</h4>
          <div class="checkbox-radio">
            {% for week in weeks %}
              <label class="option"><input type="checkbox" name="weeks" value="{{ week.w_id }}" class="clicked">{{ week.date }}</label>
            {% endfor %}
          </div>
          <button>Submit</button>
        </form>

        
      {% else %}
        <h3>No new weeks!</h3>
      {% endif %}
      <button onclick="window.location.href='/';">Back</button>
    </section>
    

{% endblock %}


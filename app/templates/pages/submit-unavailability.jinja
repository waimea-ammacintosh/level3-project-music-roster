{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Select Unavailability</h2>
    <section>
      {% if weeks %}
        <form method="post" action="/unavailability">
          <label>
            Select the dates you are unavailable for:
            <div class="checkbox-radio">
              {% for week in weeks %}
                <div class="option">
                  <label><input type="checkbox" name="weeks" value="{{ week.w_id }}" class="clicked"></label>{{ week.date }}
                </div>
              {% endfor %}
            </div>
          </label>

          <button>Submit</button>
        </form>

        
      {% else %}
        <h3>No new weeks!</h3>
      {% endif %}
      <button onclick="window.location.href='/';">Back</button>
    </section>
    

{% endblock %}


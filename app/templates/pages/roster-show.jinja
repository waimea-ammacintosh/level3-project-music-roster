{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Roster</h2>

    <section>

        {% for table in num_tables %}
            <table id="roster">
                <thead>
                    <tr>
                        <th></th>
                        {% for week in weeks %}
                            {% if week.table_id == table %}
                                <th class="date_cell">
                                    {{ week.date }}
                                </th>
                            {% endif %}
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for instrument in instruments %}
                        <tr>
                            <td class="instrument_cell">
                                {{ instrument.name }}
                            </td>
                            {% for week in roster %}
                                {% if week.i_id == instrument.id and week.table_id == table %}
                                    <td class="user_cell">
                                        {{ week.u_fname }}
                                    </td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endfor %}

        <button onclick="window.location.href='/';">Back</button>
    </section>
    
{% endblock %}


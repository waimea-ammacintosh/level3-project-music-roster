{#=====================================================
  Individual week page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>{{ week.date }}</h2>

    <section>

            <form method="post" action="/week/edit/{{ week_id }}">
                {% for instrument in instruments %}
                <label>
                    {{ instrument.name }}
                    <select name="{{ instrument.name }}">
                        {% for user in users %}
                            <option value="{{ user.u_id }}">{{ user.f_name }}</option>
                        {% else %}
                            <label>No users available for this slot</label>
                        {% endfor %}
                    </select>
                </label>
                {% endfor %}

                <button>Complete week</button>
                </form>
    </section>
    <button onclick="window.location.href='/';">Back</button>

{% endblock %}


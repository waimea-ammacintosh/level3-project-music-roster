{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Sign Up</h2>

    <section id="users">

        {% for user in users %}

            <div class="user">

                <header>
                    <h3>{{ user.first_name }}</h3>
                </header>

                <p>{{ user.last_name }}</p>
                <p>{{ user.email }}</p>

                <footer>
                    Role: {% if user.name != null %} {{ user.name }} {% else %} {{ "none" }} {% endif %}
                </footer>

            </div>

        {% else %}

            <p>No People!</p>

        {% endfor %}

    </section>

    <h2>Sign up</h2>

    <form method="post" action="/users">
    
      <label>
        First name
        <input type="text" name="first_name" required>
      </label>

      <label>
        Surname
        <input type="text" name="last_name" required>
      </label>

      <label>
        Email
        <input type="text" name="email" required>
      </label>

      <label>
        Password
        <input type="password" name="password" required>
      </label>

      <label>
            Instrument
            <select name="instrument" required>
                <option selected value="">Choose your Instrument</option>
                {% for instrument in instruments %}
                    <option>{{ instrument.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label>
            Role
            <select name="role" required>
                <option selected value="">No Role</option>
                {% for role in roles %}
                    <option>{{ role.name }}</option>
                {% endfor %}
            </select>
        </label>

      <button>Submit</button>

    </form>

{% endblock %}


{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Sign Up</h2>

    <section id="users">

        {% for user in users %}

            <div class="user">

                <header>
                    <h3>{{ user.first_name }}</h3>
                </header>

                <p>{{ user.last_name }}</p>
                <p>{{ user.email }}</p>

                <footer>
                    Role: {% if user.name != null %} {{ user.name }} {% else %} {{ "none" }} {% endif %}<br>
                    Instrument(s): 
                    {% for instrument in user["instruments"] %}
                     {{ instrument.name }}{% if instrument = user["instruments"].last() %} '' {% else %}", " {% endif %} 
                    {% endfor %}
                </footer>

            </div>

        {% else %}

            <p>No People!</p>

        {% endfor %}

    </section>

    <h2>Sign up</h2>

    <form method="post" action="/users">
    
      <label>
        First name
        <input type="text" name="first_name" required>
      </label>

      <label>
        Surname
        <input type="text" name="last_name" required>
      </label>

      <label>
        Email
        <input type="text" name="email" required>
      </label>

      <label>
        Password
        <input type="password" name="password" required>
      </label>

      <label>
        Instrument
        {% for instrument in instruments %}
          <label><input type="checkbox" name="instrument" value="{{ instrument.name }}"></label>{{ instrument.name }}<br>
        {% endfor %}
      </label>

      <label>
        Role
        <select name="role">
          <option selected value="">No Role</option>
            {% for role in roles %}
              <option>{{ role.name }}</option>
            {% endfor %}
        </select>
      </label>

      <button>Submit</button>

    </form>

{% endblock %}


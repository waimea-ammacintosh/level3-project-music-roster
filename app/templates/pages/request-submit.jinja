{#=====================================================
  Submit Request page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

  <section>    
    <h2>Submit Request</h2>
      <form method="post" action="/request/submit">
        <label>
          Select the date you want to change:
          <div class="checkbox-radio">
            {% for week in weeks %}
            <div class="option">
              <label><input type="radio" name="week" value="{{ week.week_id }}" class="clicked"></label>{{ week.date }}
            </div>
            {% else %}
              <h4>No Weeks!</h4>
            {% endfor %}
          </div>
        </label>
        <label>
          Message
          <input type="text" name="message">
        </label>

        <button>Submit</button>
      </form>

      <button onclick="window.location.href='/';">Back</button> 

  </section>

{% endblock %}


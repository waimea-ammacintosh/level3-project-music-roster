{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

  <h2>Register</h2>

  <section id="users">
    
    <form method="post" action="/users/new">
    
      <label>
        First name
        <input type="text" name="first_name" required>
      </label>

      <label>
        Surname
        <input type="text" name="last_name" required>
      </label>

      <label>
        Email
        <input type="text" name="email" required>
      </label>

      <label>
        Password
        <input type="password" name="password" required>
      </label>

      <label>
        Instrument(s):<br>
        <div class="checkbox-radio">
          {% for instrument in instruments %}
            <div class="option">
              <label><input type="checkbox" name="instrument" value="{{ instrument.name }}" class="clicked">{{ instrument.name }}</label>
            </div>
          {% endfor %}
        </div>
      </label>

      <label>
        Role
        <select name="role">
          <option selected value="">No Role</option>
          <option value="Admin">Admin</option>
        </select>
      </label>

      <button>Register</button>
      
      <button onclick="window.location.href='/';" >Cancel</button>

    </form>

    <h6>All ready got an account? <a href="/login">Sign In</a></h5>
  </section>

{% endblock %}


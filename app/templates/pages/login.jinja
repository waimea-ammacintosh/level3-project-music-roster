{#=====================================================
  Login page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

  <h2>Sign In</h2>

  <section>

      {# login form #}
    <form method="post" action="/login">
    
      <label>
        Email
        <input type="text" name="email" required>
      </label>

      <label>
        Password
        <input type="password" name="password" required>
      </label>

      <button>Sign In</button>
      <button onclick="window.location.href='/';" >Cancel</button>
    </form>

    <h6>Haven't got an account? <a href="/register">Register</a></h5>

  </section>

{% endblock %}

